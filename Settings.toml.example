[teloxide]
bot_api_token = "<telegram bot API token here>"

# Telegram nickname -> steamID64 (Dec) mappings
[players.steamid_mappings]
"tg_nick1" = "76561191234567891"
"tg_nick2" = "76561191234567892"
"tg_nick3" = "76561191234567893"

# Weather support is enabled when this section is present.
# Remove the [weather] section to disable.
[weather]
latitude = 60.1719
longitude = 24.9414
display_name = "Helsinki, FI"
# Optional Leetify Public CS API key.
# Obtain one at https://leetify.com/app/developer
#[leetify]
#api_key = "<Leetify API key>"

# Optional settings for the /el forecast shown when queues are active.
# Defaults are a 500 W gaming PC and Caruna Espoo Yleissiirto at 2.77 c/kWh
# including VAT; the fixed monthly transfer fee is not allocated to a match.
[electricity]
gaming_pc_power_watts = 500.0
caruna_espoo_distribution_cents_per_kwh = 2.77
